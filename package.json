{
  "name": "dopeshot-monorepo",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run check",
    "app:dev": "pnpm --filter dopeshot-app dev",
    "app:check": "pnpm --filter dopeshot-app check",
    "landing:dev": "pnpm --filter dopeshot-landing dev",
    "status": "pnpm --filter dopeshot-status status",
    "changeset": "changeset",
    "changeset:status": "pnpm changeset status --verbose",
    "changeset:version": "pnpm changeset version && pnpm install --no-frozen-lockfile",
    "release": "pnpm --filter dopeshot-app release",
    "db:dev": "pnpm --filter dopeshot-app db:dev",
    "db:status:staging": "./scripts/migrate.sh staging --dry-run",
    "db:deploy:staging": "./scripts/migrate.sh staging",
    "db:status:prod": "./scripts/migrate.sh prod --dry-run",
    "db:deploy:prod": "PROD_MIGRATE_CONFIRMED=yes ./scripts/migrate.sh prod",
    "sql:staging": "./scripts/sql/run.sh staging",
    "sql:prod": "PROD_SQL_CONFIRMED=yes ./scripts/sql/run.sh prod",
    "sql:local": "./scripts/sql/run.sh local",
    "sql": "./scripts/sql/run.sh"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ],
    "overrides": {
      "@types/react": "19.2.7",
      "@types/react-dom": "19.2.3"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "knip": "^5.70.2",
    "turbo": "^2.5.6"
  }
}
