{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "RESEND_API_KEY",
    "FEEDBACK_EMAIL",
    "UMAMI_API_KEY",
    "UMAMI_WEBSITE_ID",
    "SENTRY_AUTH_TOKEN"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "typecheck": {},
    "test": {},
    "check": {}
  }
}
