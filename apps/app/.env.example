# Umami Analytics Configuration
# Privacy-first, EU-compliant tracking (no cookies, no consent required)

# Get your Website ID from Umami: Settings → Websites → [Your Website] → Website ID
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-website-id-here

# Umami script URL (optional, defaults to Umami Cloud)
# Cloud (default): https://cloud.umami.is/script.js
# Self-hosted: https://your-umami-instance.com/script.js
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Prisma Database URLs
# Connection pooling (pgBouncer) - used by Prisma Client
# Get from: Supabase Dashboard → Project Settings → Database → Connection string (Transaction mode)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public,auth

# Direct connection - used by Prisma CLI (migrations, introspection)
# Get from: Supabase Dashboard → Project Settings → Database → Connection string (Session mode)
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres?schema=public,auth

# BetterAuth configuration
BETTER_AUTH_SECRET=your-secret-key-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Resend (for emails)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google OAuth (for social login)
# Get your credentials from: https://console.cloud.google.com/apis/credentials
# 1. Create a new OAuth 2.0 Client ID
# 2. Add authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
# Example: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional: used by Sentry to recognize your production host
NEXT_PUBLIC_SITE_URL=https://app.dopeshot.io
