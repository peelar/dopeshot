generator client {
  provider = "prisma-client-js"
}

generator json {
  provider = "prisma-json-types-generator"
  useType  = "PrismaJson"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

// Better-auth tables
model User {
  id             String    @id @default(uuid())
  email          String?   @unique
  emailVerified  Boolean   @default(false) @map("email_verified")
  name           String?
  image          String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  sessions        Session[]
  accounts        Account[]
  brandProfile    BrandProfile?
  userMetadata    UserMetadata?
  generatedAssets GeneratedAsset[]
  personalBackgrounds PersonalBackground[]
  backgroundSelection BackgroundSelection?
  memoryItems     MemoryItem[]

  @@map("user")
  @@schema("public")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
  @@schema("public")
}

model Account {
  id                      String    @id @default(uuid())
  userId                  String    @map("user_id")
  accountId               String    @map("account_id")
  providerId              String    @map("provider_id")
  accessToken             String?   @map("access_token")
  refreshToken            String?   @map("refresh_token")
  idToken                 String?   @map("id_token")
  accessTokenExpiresAt    DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt   DateTime? @map("refresh_token_expires_at")
  scope                   String?
  password                String?
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
  @@schema("public")
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @map("created_at")
  updatedAt  DateTime? @map("updated_at")

  @@index([identifier])
  @@map("verification")
  @@schema("public")
}

model BrandProfile {
  id     String  @id @default(cuid())
  userId String  @unique @map("user_id")
  name   String?
  personality String?

  /// [BrandColorPalette]
  colorPalette Json? @map("color_palette")

  /// [BrandTypography]
  typography Json?

  logoPath  String?  @map("logo_path")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("brand_profiles")
  @@schema("public")
}

model UserMetadata {
  id               String @id @default(cuid())
  userId           String @unique @map("user_id")
  exportsThisMonth Int    @default(0) @map("exports_this_month")
  isAdmin          Boolean @default(false) @map("is_admin")

  subscriptionTier   String @default("free") @map("subscription_tier")
  subscriptionStatus String @default("active") @map("subscription_status")

  // Billing (Polar)
  subscriptionCancelAtPeriodEnd Boolean? @map("subscription_cancel_at_period_end")
  subscriptionCurrentPeriodEnd DateTime? @map("subscription_current_period_end")
  subscriptionEndsAt DateTime? @map("subscription_ends_at")
  polarCustomerId String? @map("polar_customer_id")
  polarSubscriptionId String? @map("polar_subscription_id")

  /// [FeatureFlags]
  featureFlags Json? @map("feature_flags")

  /// [OnboardingProgress]
  onboardingProgress Json? @map("onboarding_progress")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_metadata")
  @@schema("public")
}

model GeneratedAsset {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  imagePath String   @map("image_path")
  layout    String?
  style     String?

  /// [AssetSettings]
  settings Json?

  /// [AssetMetadata]
  metadata Json?

  /// [TextOverlays]
  textOverlays Json? @map("text_overlays")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("generated_assets")
  @@schema("public")
}

model PersonalBackground {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  name       String?
  storagePath String  @map("storage_path")
  previewUrl String   @map("preview_url")
  fileSizeKb Int      @map("file_size_kb")
  widthPx    Int      @map("width_px")
  heightPx   Int      @map("height_px")
  fileFormat String   @map("file_format")
  sourceType String   @default("upload") @map("source_type")
  sourceId   String?  @map("source_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("personal_backgrounds")
  @@schema("public")
}

model AiBackground {
  id         String   @id @default(cuid())
  personality String
  status     String
  provider   String
  model      String
  prompt     String?
  seed       Int?
  storagePath String  @map("storage_path")
  previewUrl String   @map("preview_url")
  fileSizeKb Int      @map("file_size_kb")
  widthPx    Int      @map("width_px")
  heightPx   Int      @map("height_px")
  fileFormat String   @map("file_format")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([personality, status])
  @@map("ai_backgrounds")
  @@schema("public")
}

model BackgroundSelection {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  backgroundType String   @map("background_type")
  backgroundId   String   @map("background_id")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("background_selections")
  @@schema("public")
}

model MemoryItem {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  configHash      String    @map("config_hash") @db.VarChar(32)
  screenshotPath  String    @map("screenshot_path")

  /// [MemoryConfiguration]
  configuration   Json

  shareHash       String?   @unique @map("share_hash") @db.VarChar(12)
  sharedAt        DateTime? @map("shared_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, configHash])
  @@map("memory_items")
  @@schema("public")
}
